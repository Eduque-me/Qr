<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Remerciements Soutenance - Merci Chers Membres du Jury</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Playfair Display & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        botanical: {
                            50: '#f4f7f4',
                            100: '#e3ebe3',
                            200: '#c7d8c7',
                            300: '#a2be0a2',
                            400: '#799f7a',
                            500: '#568058',
                            600: '#416543',
                            700: '#355137',
                            800: '#2c422e',
                            900: '#263728',
                        },
                        terracotta: '#D97757',
                        sand: '#fbf9f5',
                    },
                    fontFamily: {
                        serif: ['Playfair Display', 'serif'],
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #fbf9f5;
            color: #2c422e;
        }
        .serif-title {
            font-family: 'Playfair Display', serif;
        }
        .glass-card {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(227, 235, 227, 0.8);
        }
        @keyframes float {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-8px) rotate(2deg); }
        }
        .animate-float {
            animation: float 5s ease-in-out infinite;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between selection:bg-botanical-200">

    <!-- En-tête / Header -->
    <header class="w-full py-6 px-4 sm:px-8 border-b border-botanical-100 bg-white/60 backdrop-blur-md sticky top-0 z-50">
        <div class="max-w-3xl mx-auto flex justify-between items-center">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-botanical-100 flex items-center justify-center text-botanical-700 font-bold shadow-sm">
                    <i class="fa-solid font-bold fa-seedling text-lg"></i>
                </div>
                <div>
                    <h1 class="font-serif font-bold text-lg text-botanical-900 leading-tight">Soutenance de Thèse / Mémoire</h1>
                    <p class="text-xs text-botanical-600">Un geste de gratitude & de croissance</p>
                </div>
            </div>
            
            <button onclick="shareCard()" class="text-xs bg-botanical-50 hover:bg-botanical-100 text-botanical-800 py-2 px-3.5 rounded-full border border-botanical-200 transition-all flex items-center gap-1.5 shadow-sm">
                <i class="fa-solid fa-share-nodes"></i>
                <span class="hidden sm:inline">Partager</span>
            </button>
        </div>
    </header>

    <!-- Contenu Principal -->
    <main class="max-w-3xl mx-auto w-full px-4 py-8 sm:py-12 space-y-8 flex-grow">

        <!-- Carte de Sélection du Destinataire -->
        <section class="bg-white rounded-2xl p-4 sm:p-6 shadow-sm border border-botanical-100">
            <label for="profSelector" class="block text-xs uppercase tracking-wider text-botanical-600 font-semibold mb-2">
                <i class="fa-solid fa-user-graduate mr-1"></i> Destinataire de cette attention :
            </label>
            <select id="profSelector" onchange="changeProf(this.value)" class="w-full bg-sand border border-botanical-200 text-botanical-900 text-sm rounded-xl focus:ring-botanical-500 focus:border-botanical-500 p-3 font-medium cursor-pointer transition-all">
                <option value="0">Professeur A — Président du Jury</option>
                <option value="1">Professeur B — Directeur de Thèse / Encadrant</option>
                <option value="2">Professeur C — Rapporteur</option>
                <option value="3">Professeur D — Examinateur</option>
            </select>
        </section>

        <!-- Message Principal de Remerciement -->
        <section class="glass-card rounded-3xl p-6 sm:p-10 shadow-xl relative overflow-hidden transition-all duration-300">
            <!-- Élément décoratif végétal en arrière-plan -->
            <div class="absolute -right-10 -bottom-10 opacity-10 text-botanical-700 pointer-events-none">
                <i class="fa-solid fa-leaf text-[220px]"></i>
            </div>

            <!-- Entête du message -->
            <div class="mb-6 border-b border-botanical-100 pb-6">
                <span class="inline-block px-3 py-1 bg-botanical-100 text-botanical-800 text-xs font-semibold rounded-full mb-3" id="profRole">
                    Président du Jury
                </span>
                <h2 class="serif-title text-2xl sm:text-3xl font-bold text-botanical-900" id="profName">
                    Professeur [Nom du Professeur 1]
                </h2>
            </div>

            <!-- Corps du Message -->
            <div class="space-y-4 text-botanical-800 leading-relaxed text-sm sm:text-base font-normal">
                <p id="profMessage" class="italic font-serif text-lg text-botanical-900 mb-4">
                    "Je vous remercie chaleureusement pour votre temps, vos conseils avisés et la bienveillance apportée lors de l'évaluation de mes travaux."
                </p>
                <p>
                    Cette petite plante succulente représente la persévérance, l'apprentissage continu et la croissance — des valeurs que vous m'avez transmises au cours de mon parcours académique.
                </p>
                <p>
                    Veuillez accepter ce humble symbole d'appréciation pour votre engagement auprès des étudiants et la qualité de votre encadrement.
                </p>
            </div>

            <!-- Signature -->
            <div class="mt-8 pt-6 border-t border-botanical-100 flex items-center justify-between">
                <div>
                    <p class="text-xs text-botanical-500 uppercase tracking-wider font-semibold">Avec toute ma gratitude,</p>
                    <p class="font-serif font-bold text-lg text-botanical-900 mt-0.5" id="studentName">Votre Nom & Prénom</p>
                </div>
                <div class="w-12 h-12 bg-botanical-50 rounded-2xl flex items-center justify-center text-botanical-600 animate-float">
                    <i class="fa-solid fa-heart text-xl text-terracotta"></i>
                </div>
            </div>
        </section>

        <!-- Fiche Récapitulative de la Soutenance -->
        <section class="bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-botanical-100 space-y-4">
            <h3 class="serif-title font-bold text-xl text-botanical-900 flex items-center gap-2">
                <i class="fa-solid fa-book-bookmark text-botanical-500 text-lg"></i>
                Détails des Travaux Présentés
            </h3>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
                <div class="bg-sand p-4 rounded-2xl border border-botanical-100">
                    <p class="text-xs text-botanical-500 font-semibold uppercase">Titre du travail</p>
                    <p class="text-sm font-semibold text-botanical-900 mt-1" id="thesisTitle">
                        Intitulé exact de votre sujet de mémoire ou de thèse de doctorat
                    </p>
                </div>

                <div class="bg-sand p-4 rounded-2xl border border-botanical-100">
                    <p class="text-xs text-botanical-500 font-semibold uppercase">Diplôme / Discipline</p>
                    <p class="text-sm font-semibold text-botanical-900 mt-1" id="degreeTitle">
                        Master / Doctorat en [Votre Spécialité]
                    </p>
                </div>

                <div class="bg-sand p-4 rounded-2xl border border-botanical-100">
                    <p class="text-xs text-botanical-500 font-semibold uppercase">Établissement / Université</p>
                    <p class="text-sm font-semibold text-botanical-900 mt-1" id="universityName">
                        Nom de l'Université ou Grande École
                    </p>
                </div>

                <div class="bg-sand p-4 rounded-2xl border border-botanical-100">
                    <p class="text-xs text-botanical-500 font-semibold uppercase">Date de soutenance</p>
                    <p class="text-sm font-semibold text-botanical-900 mt-1" id="defenseDate">
                        20 Octobre 2026
                    </p>
                </div>
            </div>
        </section>

        <!-- Guide d'Entretien de la Plante Grasse -->
        <section class="bg-botanical-800 text-white rounded-3xl p-6 sm:p-8 shadow-lg relative overflow-hidden">
            <div class="flex items-center gap-3 mb-6">
                <div class="w-10 h-10 rounded-xl bg-botanical-700/80 flex items-center justify-center text-botanical-200">
                    <i class="fa-solid fa-sun text-lg"></i>
                </div>
                <div>
                    <h3 class="serif-title text-xl font-bold">Conseils pour prendre soin de votre plante</h3>
                    <p class="text-xs text-botanical-200">Succulente / Petite Plante d'Intérieur</p>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div class="bg-botanical-900/50 p-4 rounded-2xl border border-botanical-700/50">
                    <div class="flex items-center gap-2 text-terracotta font-semibold text-sm mb-1">
                        <i class="fa-solid fa-droplet"></i> Arrosage
                    </div>
                    <p class="text-xs text-botanical-100 leading-relaxed">
                        Arroser très modérément. Une fois toutes les 2 à 3 semaines en laissant bien sécher la terre.
                    </p>
                </div>

                <div class="bg-botanical-900/50 p-4 rounded-2xl border border-botanical-700/50">
                    <div class="flex items-center gap-2 text-amber-400 font-semibold text-sm mb-1">
                        <i class="fa-solid fa-lightbulb"></i> Lumière
                    </div>
                    <p class="text-xs text-botanical-100 leading-relaxed">
                        Aime la lumière vive sans exposition directe brûlante. Près d'une fenêtre de bureau est parfait !
                    </p>
                </div>

                <div class="bg-botanical-900/50 p-4 rounded-2xl border border-botanical-700/50">
                    <div class="flex items-center gap-2 text-emerald-400 font-semibold text-sm mb-1">
                        <i class="fa-solid fa-spa"></i> Symbolique
                    </div>
                    <p class="text-xs text-botanical-100 leading-relaxed">
                        Symbole de durabilité, de mémoire vivante et de succès dans le temps.
                    </p>
                </div>
            </div>
        </section>

    </main>

    <!-- Pied de Page / Footer -->
    <footer class="w-full py-6 text-center text-xs text-botanical-500 border-t border-botanical-100 bg-white/40">
        <p>© 2026 — Fait avec gratitude pour le Jury de Soutenance</p>
    </footer>

    <!-- Message notification toast -->
    <div id="toast" class="fixed bottom-6 right-6 bg-botanical-900 text-white text-xs px-4 py-3 rounded-xl shadow-2xl opacity-0 transition-opacity duration-300 pointer-events-none flex items-center gap-2">
        <i class="fa-solid fa-circle-check text-emerald-400"></i>
        <span id="toastMessage">Lien copié dans le presse-papier !</span>
    </div>

    <!-- Script JavaScript Dynamique -->
    <script>
        // Données modifiables des professeurs (Personnalisez facilement les noms et messages ici)
        const professorsData = [
            {
                name: "Prof. Jean DUPONT",
                role: "Président du Jury",
                message: "Mme/M. le Président, je vous adresse mes plus sincères remerciements pour avoir présidé cette session de soutenance et guidé les débats avec rigueur et bienveillance."
            },
            {
                name: "Prof. Marie MARTIN",
                role: "Directrice de Thèse / Encadrante",
                message: "Chère Directrice, un grand merci pour votre accompagnement précieux, vos encouragements constants et votre patience tout au long de la rédaction de ce travail."
            },
            {
                name: "Prof. Ahmed BENALI",
                role: "Rapporteur du Jury",
                message: "M. le Rapporteur, merci d'avoir pris le temps d'analyser en détail mon manuscrit et pour la pertinence de vos remarques constructives qui enrichissent mes travaux."
            },
            {
                name: "Prof. Sophie LEROY",
                role: "Examinatrice du Jury",
                message: "Mme l'Examinatrice, je vous remercie chaleureusement pour votre présence, l'intérêt porté à mes recherches et la clarté de vos précieux retours."
            }
        ];

        // Infos Générales de la Soutenance
        const defenseInfo = {
            student: "Votre Prénom & Nom",
            title: "Optimisation et Impact de l'Innovation dans les Systèmes Complexes",
            degree: "Doctorat / Master Recherche en Informatique",
            university: "Université de Paris - Sorbonne",
            date: "20 Octobre 2026"
        };

        // Initialisation de la page
        window.addEventListener('DOMContentLoaded', () => {
            document.getElementById('studentName').innerText = defenseInfo.student;
            document.getElementById('thesisTitle').innerText = defenseInfo.title;
            document.getElementById('degreeTitle').innerText = defenseInfo.degree;
            document.getElementById('universityName').innerText = defenseInfo.university;
            document.getElementById('defenseDate').innerText = defenseInfo.date;

            // Détection du paramètre prof dans l'URL (ex: ?prof=1)
            const urlParams = new URLSearchParams(window.location.search);
            const profIndex = parseInt(urlParams.get('prof')) || 0;
            
            if (profIndex >= 0 && profIndex < professorsData.length) {
                document.getElementById('profSelector').value = profIndex;
                changeProf(profIndex);
            } else {
                changeProf(0);
            }
        });

        // Fonction pour changer le destinataire
        function changeProf(index) {
            const prof = professorsData[index];
            if (!prof) return;

            document.getElementById('profName').innerText = prof.name;
            document.getElementById('profRole').innerText = prof.role;
            document.getElementById('profMessage').innerText = `"${prof.message}"`;
        }

        // Partage du lien ou copie rapide
        function shareCard() {
            const currentProf = document.getElementById('profSelector').value;
            const shareUrl = window.location.href.split('?')[0] + '?prof=' + currentProf;

            if (navigator.share) {
                navigator.share({
                    title: 'Remerciements Soutenance',
                    text: 'Un message de remerciement pour votre présence lors de ma soutenance.',
                    url: shareUrl
                }).catch(() => {});
            } else {
                // Secours copie presse-papier
                const dummy = document.createElement('input');
                document.body.appendChild(dummy);
                dummy.value = shareUrl;
                dummy.select();
                document.execCommand('copy');
                document.body.removeChild(dummy);

                showToast("Lien vers cette carte copié !");
            }
        }

        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toastMessage').innerText = msg;
            toast.classList.remove('opacity-0', 'pointer-events-none');
            setTimeout(() => {
                toast.classList.add('opacity-0', 'pointer-events-none');
            }, 3000);
        }
    </script>
</body>
</html>